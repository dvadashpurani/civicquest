# Copy to .env.local (gitignored) and fill in. The app refuses to start if any
# of these five is missing or empty. Never commit real values.

# Public: inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only: read through lib/env.ts. Never rename with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Demo logins and "Reset demo data" are enabled only when exactly `true`.
DEMO_MODE=true
